{
  "name": "Aion Health Care Website",
  "description": "Professional healthcare website with SEO optimization, accessibility features, and comprehensive care services information",
  "type": "static",
  "build": {
    "builder": "bun",
    "install_command": "bun install",
    "build_command": "bun run build",
    "publish_directory": "dist",
    "environment_variables": [
      {
        "key": "NODE_ENV",
        "value": "production"
      },
      {
        "key": "ANALYTICS_ID",
        "value": ""
      },
      {
        "key": "CONTACT_EMAIL",
        "value": "info@aionhcss.com"
      },
      {
        "key": "PHONE_NUMBER",
        "value": "07368195705"
      }
    ]
  },
  "health_check": {
    "path": "/",
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "domains": [
    {
      "name": "www.aionhcss.com",
      "primary": true
    },
    {
      "name": "aionhcss.com"
    }
  ],
  "ssl": {
    "enabled": true,
    "provider": "letsencrypt"
  },
  "cdn": {
    "enabled": true,
    "regions": ["global"]
  },
  "monitoring": {
    "enabled": true,
    "alerts": {
      "email": "admin@aionhcss.com",
      "uptime_threshold": 95
    }
  },
  "backups": {
    "enabled": true,
    "schedule": "daily",
    "retention": 30
  }
}